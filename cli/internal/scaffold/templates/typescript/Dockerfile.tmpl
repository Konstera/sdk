# {{ .AgentName }} — Konstera agent.
# Multi-stage build; produces a small runtime image.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json tsconfig.json ./
RUN npm install
COPY src ./src
RUN npm run build

FROM node:22-alpine AS runtime
RUN addgroup -S agent && adduser -S -G agent agent
WORKDIR /app

COPY --from=build /app/package.json /app/node_modules ./
COPY --from=build /app/dist ./dist

USER agent
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=8s --retries=3 \
    CMD wget -qO- http://localhost:8080/health >/dev/null 2>&1 || exit 1

ENTRYPOINT ["node", "dist/index.js"]
